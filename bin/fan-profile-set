#!/bin/bash
# Root-owned helper: writes one of four fan-curve profiles to /etc/fancontrol
# and restarts the service. Meant to be invoked via a narrowly-scoped sudoers
# NOPASSWD entry (see install.sh) so a desktop widget can switch curves
# without a password prompt each time.
#
# The it87/it8688 hwmon device is auto-detected by NAME every time this runs,
# rather than hardcoded, so it keeps working even if the hwmon number shifts
# across reboots (which does happen with force-loaded Super I/O drivers).
#
# ---- Board-specific settings — adjust these for YOUR motherboard ----------
# Run `sensors` after loading it87/it8688 to see your own fan/temp labels.
# On many Gigabyte AM4 boards using this driver, pwm1=CPU_FAN, pwm3=SYS_FAN2,
# and temp3 is the CPU-area sensor — see the README for how to check yours.
PWM_PRIMARY="pwm1"     # fan header driven by the "aggressive" curve (e.g. CPU_FAN)
PWM_SECONDARY="pwm3"   # fan header driven by the "conservative floor" curve
TEMP_SOURCE="temp3"    # which chip temp input drives both curves
# -----------------------------------------------------------------------

set -e

PROFILE="$1"

# Find the it87-family hwmon device by name instead of hardcoding a number.
HWMON=""
for d in /sys/class/hwmon/hwmon*; do
  name=$(cat "$d/name" 2>/dev/null)
  case "$name" in
    it86*|it87*) HWMON=$(basename "$d"); HWMON_NAME="$name" ;;
  esac
done

if [ -z "$HWMON" ]; then
  echo "No it86xx/it87xx hwmon device found. Is the it87 driver loaded?" >&2
  exit 1
fi

DEVPATH_REL=$(readlink -f "/sys/class/hwmon/$HWMON/device" | sed 's#/sys/##')

HEADER="# Auto-generated by fan-profile-set — do not edit by hand, edit the script instead
INTERVAL=10
DEVPATH=$HWMON=$DEVPATH_REL
DEVNAME=$HWMON=$HWMON_NAME
FCTEMPS=$HWMON/$PWM_PRIMARY=$HWMON/$TEMP_SOURCE $HWMON/$PWM_SECONDARY=$HWMON/$TEMP_SOURCE
FCFANS=$HWMON/$PWM_PRIMARY=$HWMON/fan1_input $HWMON/$PWM_SECONDARY=$HWMON/fan3_input"

case "$PROFILE" in
  silent)
    # Most extreme: ramps start later. Averaging temp over 6 samples
    # (~60s at INTERVAL=10) filters out brief CPU spikes, and as a side
    # effect makes any real ramp-up gradual too, since the averaged value
    # itself only rises slowly.
    BODY="AVERAGE=$HWMON/$PWM_PRIMARY=6 $HWMON/$PWM_SECONDARY=6
MINTEMP=$HWMON/$PWM_PRIMARY=50 $HWMON/$PWM_SECONDARY=50
MAXTEMP=$HWMON/$PWM_PRIMARY=88 $HWMON/$PWM_SECONDARY=85
MINSTART=$HWMON/$PWM_PRIMARY=100 $HWMON/$PWM_SECONDARY=160
MINSTOP=$HWMON/$PWM_PRIMARY=45 $HWMON/$PWM_SECONDARY=90
MINPWM=$HWMON/$PWM_PRIMARY=0 $HWMON/$PWM_SECONDARY=90
MAXPWM=$HWMON/$PWM_PRIMARY=255 $HWMON/$PWM_SECONDARY=255"
    ;;
  quiet)
    BODY="MINTEMP=$HWMON/$PWM_PRIMARY=40 $HWMON/$PWM_SECONDARY=40
MAXTEMP=$HWMON/$PWM_PRIMARY=80 $HWMON/$PWM_SECONDARY=78
MINSTART=$HWMON/$PWM_PRIMARY=100 $HWMON/$PWM_SECONDARY=160
MINSTOP=$HWMON/$PWM_PRIMARY=50 $HWMON/$PWM_SECONDARY=100
MINPWM=$HWMON/$PWM_PRIMARY=0 $HWMON/$PWM_SECONDARY=100
MAXPWM=$HWMON/$PWM_PRIMARY=255 $HWMON/$PWM_SECONDARY=255"
    ;;
  balanced)
    BODY="MINTEMP=$HWMON/$PWM_PRIMARY=30 $HWMON/$PWM_SECONDARY=30
MAXTEMP=$HWMON/$PWM_PRIMARY=70 $HWMON/$PWM_SECONDARY=65
MINSTART=$HWMON/$PWM_PRIMARY=100 $HWMON/$PWM_SECONDARY=160
MINSTOP=$HWMON/$PWM_PRIMARY=60 $HWMON/$PWM_SECONDARY=140
MINPWM=$HWMON/$PWM_PRIMARY=0 $HWMON/$PWM_SECONDARY=140
MAXPWM=$HWMON/$PWM_PRIMARY=255 $HWMON/$PWM_SECONDARY=255"
    ;;
  performance)
    BODY="MINTEMP=$HWMON/$PWM_PRIMARY=25 $HWMON/$PWM_SECONDARY=25
MAXTEMP=$HWMON/$PWM_PRIMARY=55 $HWMON/$PWM_SECONDARY=50
MINSTART=$HWMON/$PWM_PRIMARY=100 $HWMON/$PWM_SECONDARY=160
MINSTOP=$HWMON/$PWM_PRIMARY=80 $HWMON/$PWM_SECONDARY=160
MINPWM=$HWMON/$PWM_PRIMARY=60 $HWMON/$PWM_SECONDARY=160
MAXPWM=$HWMON/$PWM_PRIMARY=255 $HWMON/$PWM_SECONDARY=255"
    ;;
  *)
    echo "Usage: fan-profile-set {silent|quiet|balanced|performance}" >&2
    exit 1
    ;;
esac

printf '%s\n%s\n' "$HEADER" "$BODY" > /etc/fancontrol
systemctl restart fancontrol.service
echo "$PROFILE" > /run/fan-profile-current
chmod 644 /run/fan-profile-current
